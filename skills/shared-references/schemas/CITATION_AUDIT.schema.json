{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciforge/schemas/CITATION_AUDIT.schema.json",
  "title": "CITATION_AUDIT.json - 3-layer citation verification verdict",
  "description": "Produced by /citation-audit ('Submission Artifact Emission' section in its SKILL.md), which always emits this artifact - a paper with no .bib or no \\cite usage emits NOT_APPLICABLE. Conforms to the assurance-contract.md audit envelope; per-entry ledger lives under details.per_entry. Top-level verdict derived from per-entry verdicts per the decision table.",
  "type": "object",
  "required": [
    "audit_skill",
    "verdict",
    "reason_code",
    "summary",
    "audited_input_hashes",
    "trace_path",
    "thread_id",
    "reviewer_model",
    "reviewer_reasoning",
    "generated_at",
    "details"
  ],
  "properties": {
    "audit_skill": {
      "type": "string",
      "enum": ["citation-audit"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE", "BLOCKED", "ERROR"]
    },
    "reason_code": {
      "type": "string",
      "description": "e.g. all_entries_keep, metadata_drift, wrong_context, hallucinated."
    },
    "summary": {
      "type": "string"
    },
    "audited_input_hashes": {
      "type": "object",
      "description": "SHA256 of references.bib and every audited .tex file (paper-relative paths).",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
      }
    },
    "trace_path": {
      "type": "string"
    },
    "thread_id": {
      "type": "string",
      "description": "Reviewer thread id (present in the skill's own emission example)."
    },
    "reviewer_model": {
      "type": "string"
    },
    "reviewer_reasoning": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"
    },
    "details": {
      "type": "object",
      "required": ["total_entries", "per_entry"],
      "properties": {
        "total_entries": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "properties": {
            "KEEP": {
              "type": "integer",
              "minimum": 0
            },
            "FIX": {
              "type": "integer",
              "minimum": 0
            },
            "REPLACE": {
              "type": "integer",
              "minimum": 0
            },
            "REMOVE": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "per_entry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "verdict"],
            "properties": {
              "key": {
                "type": "string",
                "description": "Bib cite key."
              },
              "verdict": {
                "type": "string",
                "enum": ["KEEP", "FIX", "REPLACE", "REMOVE"]
              },
              "axis_failures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["CONTEXT", "METADATA", "EXISTENCE"]
                }
              },
              "uses": {
                "type": "array",
                "description": "Per-occurrence citation-context verdicts.",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "verdict": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "uncited_entries": {
          "type": "array",
          "description": "Only with --uncited opt-in; detect-only, never affects the top-level verdict."
        },
        "uncited_entries_status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
