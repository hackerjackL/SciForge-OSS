{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciforge/schemas/FAIRNESS.schema.json",
  "title": "FAIRNESS.json - experiment fairness verdict (mode=deepen, v1.5.0-w2)",
  "description": "Registered verdict produced by the deepen-mode fairness audit. Every comparison table must be re-run under identical budget/splits/seeds/metric definitions; any asymmetry is a FAIL. Publishability-score main-experiment-logic axis REQUIRES fairness PASS when this file is present.",
  "type": "object",
  "required": ["gate", "version", "verdict", "checks", "comparisons", "numbers_stale", "generated_at"],
  "properties": {
    "gate": {"type": "string", "enum": ["experiment-fairness"]},
    "version": {"type": "string"},
    "verdict": {"type": "string", "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE", "BLOCKED", "ERROR"]},
    "checks": {
      "type": "object",
      "required": ["compute_budget_parity", "data_split_lock", "seed_policy", "hparam_budget_parity", "metric_definitions"],
      "properties": {
        "compute_budget_parity": {"type": "string", "enum": ["PASS", "FAIL", "N_A"]},
        "data_split_lock": {"type": "string", "enum": ["PASS", "FAIL", "N_A"]},
        "seed_policy": {"type": "string", "enum": ["PASS", "FAIL", "N_A"]},
        "hparam_budget_parity": {"type": "string", "enum": ["PASS", "FAIL", "N_A"]},
        "metric_definitions": {"type": "string", "enum": ["PASS", "FAIL", "N_A"]}
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_id", "methods", "seed_count", "mean_std_reported", "effect_size_reported", "ci_reported", "multiple_comparison_control"],
        "properties": {
          "table_id": {"type": "string"},
          "methods": {"type": "array", "items": {"type": "string"}},
          "seed_count": {"type": "integer", "minimum": 1},
          "mean_std_reported": {"type": "boolean"},
          "effect_size_reported": {"type": "boolean"},
          "ci_reported": {"type": "boolean"},
          "multiple_comparison_control": {"type": "string", "enum": ["none", "bonferroni", "bh", "holm", "tukey"]}
        }
      }
    },
    "split_hash": {"type": "string", "description": "sha256 of the frozen data-split manifest"},
    "compute_budget_per_method": {"type": "object"},
    "numbers_stale": {"type": "boolean", "description": "true when tables predate the fairness re-run and must be regenerated"},
    "unfair_notes": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"}
  }
}
