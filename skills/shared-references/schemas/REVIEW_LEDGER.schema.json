{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciforge/schemas/REVIEW_LEDGER.schema.json",
  "title": "REVIEW_LEDGER.json - authoritative machine-readable review record",
  "description": "Produced by /auto-review-loop Phase E.5 (per round) + finalized at termination. Two doc sources disagree on shape: auto-review-loop SKILL.md describes a JSONL stream of round entries, while artifact-registry.md describes an object with details.rounds[] (per-round: score, verdict, action_items, debate_rulings, statistical_gate). This schema follows artifact-registry.md (single JSON object) because a .json file must be parseable JSON; the JSONL form is a known gap (see schemas/README.md). Per-round fields are the union of both docs, optional except the core four.",
  "type": "object",
  "required": ["details"],
  "properties": {
    "audit_skill": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE", "BLOCKED", "ERROR"],
      "description": "Top-level 6-state verdict per artifact-registry.md. Optional because the auto-review-loop JSONL description has no top-level envelope."
    },
    "reason_code": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"
    },
    "details": {
      "type": "object",
      "required": ["rounds"],
      "properties": {
        "rounds": {
          "type": "array",
          "description": "One entry per review round; at termination a final entry with phase=finalized carries final_score / final_verdict / total_rounds.",
          "items": {
            "type": "object",
            "required": ["round", "score", "verdict", "phase"],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "timestamp": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "verdict": {
                "type": "string",
                "enum": ["ready", "almost", "not_ready", "not ready"]
              },
              "phase": {
                "type": "string",
                "enum": ["documented", "finalized"]
              },
              "key_criticisms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions_taken": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "action_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "artifact-registry.md field name."
              },
              "debate_rulings": {
                "description": "artifact-registry.md field (Phase B.6 debate rulings); shape not fixed by the docs."
              },
              "statistical_gate": {
                "description": "artifact-registry.md field read by paper-writing Phase 0.5; shape not fixed by the docs."
              },
              "fidelity_delta": {
                "type": "object",
                "description": "Fidelity level changes per outcome (auto-review-loop field)."
              },
              "blockers_remaining": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "final_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Finalized entry only."
              },
              "final_verdict": {
                "type": "string",
                "description": "Finalized entry only."
              },
              "total_rounds": {
                "type": "integer",
                "minimum": 1,
                "description": "Finalized entry only."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
