{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciforge/schemas/INVARIANT_CHECK.schema.json",
  "title": "INVARIANT_CHECK.json - phase-boundary structural invariant verdict",
  "description": "Produced by /invariant-check ('Output Format' in its SKILL.md). OSS runs the single universal invariant INV-G1 PROBLEM_ANCHOR_FREEZE. This artifact uses overall_verdict (worst across checks: ERROR > BLOCKED > FAIL > WARN > NOT_APPLICABLE > PASS) instead of a top-level 'verdict' field.",
  "type": "object",
  "required": ["timestamp", "phase_boundary", "discipline_context", "overall_verdict", "checks"],
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"
    },
    "phase_boundary": {
      "type": "string",
      "description": "e.g. before-theory-derivation, before-logic-verification, before-paper-writing, before-result-to-claim."
    },
    "discipline_context": {
      "type": "string",
      "description": "Always 'general' in OSS."
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE", "BLOCKED", "ERROR"],
      "description": "6-state vocabulary; worst verdict across all triggered checks."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "verdict", "detail", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Invariant id, e.g. INV-G1."
          },
          "name": {
            "type": "string",
            "description": "Invariant name, e.g. PROBLEM_ANCHOR_FREEZE."
          },
          "verdict": {
            "type": "string",
            "enum": ["PASS", "WARN", "FAIL", "NOT_APPLICABLE", "BLOCKED", "ERROR"],
            "description": "Per-check verdict. FAIL covers both 'Q-id absent' and 'problem drift'; content-rewrite mismatch is FAIL (problem_content_rewritten)."
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
