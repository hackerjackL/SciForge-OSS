# SciForge-OSS .gitignore

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.iml

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/

# LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz
*.toc
*.lof
*.lot

# Build
dist/
build/
*.egg

# SciForge runtime
.sciforge/
!fixtures/e2e_minimal/.sciforge/
# The exception above re-includes everything under the fixture's .sciforge/,
# so gate side-effects written when an audit runs against the fixture would be
# tracked as if they were fixture content. AUDIT_TRAIL.json was already
# untracked once for exactly this reason (c74157a); keep both runtime products
# out. The fixture's own declared artifacts stay tracked.
fixtures/e2e_minimal/.sciforge/audits/AUDIT_TRAIL.json
fixtures/e2e_minimal/.sciforge/audits/INTEGRITY_MONITOR.json
# daemon runtime state: SQLite queue + per-start auth token + derived queue mirror
.sciforge-daemon/
queue.json
review-stage/
derivations/
paper/
figures/
# demo corpus SOURCE specs are first-class (publication-grade fixtures);
# their rendered outputs are reproducible and stay out of the tree
!demos/figures/
demos/rendered/
literature/
methods/
audit_report/
refine-logs/
results/
output/
tools/
.KILL_ARGUMENT.md
KILL_ARGUMENT.md
KILL_ARGUMENT.json
KILL_ARGUMENT.html
# The rules above exclude a run-side KILL_ARGUMENT.json by bare filename, which
# also swallows the e2e fixture's registered verdict of the same name. That
# verdict is checked-in fixture content (validate_verdicts --require-complete
# needs all 24), so re-include it. Must come AFTER the bare-filename rule: in
# gitignore the last match wins.
!fixtures/e2e_minimal/.sciforge/verdicts/KILL_ARGUMENT.json
# eval harness (test scaffolding, not shipped)
scripts/eval/
.venv/

# SciForge evaluation runs (ARC-Bench etc.) — test artifacts, never shipped
runs/ARC-BENCH/
runs/ARC-BENCH2/
runs/EVAL-T1/
runs/S01/
bench/s2demo/results/

# stray top-level eval logs (agents leak cwd-relative logs here)
logs/
runs/LESSONS_INDEX.jsonl
