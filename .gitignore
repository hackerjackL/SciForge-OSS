# SciForge-OSS .gitignore

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.iml

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/

# LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz
*.toc
*.lof
*.lot

# Build
dist/
build/
*.egg

# SciForge runtime
.sciforge/
!fixtures/e2e_minimal/.sciforge/
review-stage/
derivations/
paper/
figures/
# demo corpus SOURCE specs are first-class (publication-grade fixtures);
# their rendered outputs are reproducible and stay out of the tree
!demos/figures/
demos/rendered/
literature/
methods/
audit_report/
refine-logs/
results/
output/
tools/
.KILL_ARGUMENT.md
KILL_ARGUMENT.md
KILL_ARGUMENT.json
KILL_ARGUMENT.html
# eval harness (test scaffolding, not shipped)
scripts/eval/
.venv/

# SciForge evaluation runs (ARC-Bench etc.) — test artifacts, never shipped
runs/ARC-BENCH/
runs/ARC-BENCH2/
runs/EVAL-T1/
bench/s2demo/results/
